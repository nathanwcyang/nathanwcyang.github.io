---
// One home-page section: a heading, then its content. Fades up gently unless reduced motion is on.
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} data-fade class="py-12 border-t border-border first:border-t-0">
  <h2 id={`${id}-title`} class="mb-8 text-3xl font-bold tracking-tight">{title}</h2>
  <slot />
</section>
