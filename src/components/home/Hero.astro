---
// Photo on the left, name and contact on the right, stacked on phones (the template's "about" section).
import { Image } from "astro:assets";
import headshot from "../../assets/nathan-yang.jpg";
import { Button } from "../ui/Button";
import { Icon } from "../ui/Icon";
import { EnvelopeSimple, LinkedinLogo, MapPin } from "@phosphor-icons/react/dist/ssr";
import { SITE_EMAIL, SITE_LINKEDIN } from "../../config";
---

<section id="hero" aria-labelledby="hero-title" data-fade class="grid gap-8 py-16 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-12 sm:py-24">
  <Image
    src={headshot}
    alt="Nathan Yang in his University of Waterloo graduation gown"
    widths={[192, 384]}
    sizes="12rem"
    format="webp"
    loading="eager"
    class="size-40 sm:size-48 rounded-full object-cover object-[center_25%] ring-4 ring-[var(--color-accent)]"
  />
  <div>
    <h1 id="hero-title" class="text-4xl sm:text-6xl font-bold tracking-tight">Nathan Yang</h1>
    <p class="mt-2 text-lg sm:text-xl text-secondary">Doctor of Pharmacy Student, University of Waterloo · Class of 2027</p>
    <p class="mt-3 inline-flex items-center gap-1.5 text-secondary">
      <Icon icon={MapPin} size="sm" />
      Based in Mississauga, Ontario
    </p>
    <div class="mt-5 max-w-prose space-y-3">
      <p>
        I'm a third-year PharmD student with a background in specialty, community and hospital pharmacy. Before
        pharmacy, I spent time in fintech. I'm always happy to talk about AI, vibe coding and design!
      </p>
      <p>
        When I'm not wearing my white coat, I nerd out on music production, photography and what makes an image look
        great on a cinema screen :)
      </p>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button variant="primary" label="Email" href={`mailto:${SITE_EMAIL}`} icon={EnvelopeSimple} />
      <Button label="LinkedIn" href={SITE_LINKEDIN} target="_blank" rel="noopener" icon={LinkedinLogo} />
    </div>
  </div>
</section>
