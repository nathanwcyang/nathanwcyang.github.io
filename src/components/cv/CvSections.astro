---
// The CV, shown on the home page below Projects: Experience, Education (with Certifications), Skills.
// Text lives in src/content/cv.md.
import Section from "../home/Section.astro";
import TimeLineElement from "./TimeLine.astro";
import { Tag } from "../ui/Tag";
import { getEntry } from "astro:content";

const cv = (await getEntry("cv", "cv"))!.data;

// shortcut: only handles [text](url) links; switch to a markdown renderer if cv.md needs more.
const inlineMd = (s: string) =>
  s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="font-semibold text-accent underline">$1</a>');
---

<Section id="experience" title="Experience">
  {cv.experience.map((job) => (
    <TimeLineElement title={job.title} org={job.org} type={job.type} location={job.location} dates={job.dates}>
      <ul class="ml-5 list-disc space-y-1">
        {job.bullets.map((b) => <li>{b}</li>)}
      </ul>
      {job.achievement && <p slot="achievements" set:html={inlineMd(job.achievement)} />}
    </TimeLineElement>
  ))}
</Section>

<Section id="education" title="Education">
  {cv.education.map((e) => <TimeLineElement title={e.title} org={e.org} dates={e.dates} />)}
  <h3 class="mb-3 mt-2 text-lg font-bold">Certifications</h3>
  <ul class="ml-5 list-disc space-y-1">
    {cv.certifications.map((c) => <li>{c}</li>)}
  </ul>
</Section>

<Section id="skills" title="Skills">
  <div class="space-y-6">
    {cv.skills.map(({ group, items }) => (
      <div>
        <h3 class="text-lg font-bold">{group}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {items.map((s) => <li><Tag label={s} /></li>)}
        </ul>
      </div>
    ))}
  </div>
</Section>
