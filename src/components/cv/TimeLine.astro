---
// One CV timeline entry: an accent dot on a line, then
// row 1: title (left) and dates (right); row 2: org · location; row 3: type (e.g. Co-op), italic.
// Default slot: what was done. Optional "achievements" slot: shown under a "Key achievements" label.
const { title, org, dates, location, type } = Astro.props;
const hasAchievements = Astro.slots.has("achievements");
---

<div class="flex">
  <div class="flex flex-col items-center" aria-hidden="true">
    <span class="mt-1.5 block size-3.5 shrink-0 rounded-full bg-accent-bg"></span>
    <span class="block w-0.5 grow bg-accent-muted"></span>
  </div>
  <div class="grow px-5 pb-8">
    <div class="flex flex-wrap justify-between gap-x-4">
      <h3 class="text-lg font-bold">{title}</h3>
      <span class="text-secondary whitespace-nowrap">{dates}</span>
    </div>
    <p class="text-secondary">{location ? `${org} · ${location}` : org}</p>
    {type && <p class="text-secondary italic">{type}</p>}
    <div class="my-2">
      <slot />
    </div>
    {
      hasAchievements && (
        <div>
          <p class="mt-1 mb-1 text-sm font-bold uppercase tracking-wider text-secondary">Key achievements</p>
          <slot name="achievements" />
        </div>
      )
    }
  </div>
</div>
