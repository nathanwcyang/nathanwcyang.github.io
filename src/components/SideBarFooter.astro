---
import { SITE_EMAIL, SITE_LINKEDIN } from "../config";
---
<div
    class="block sticky pointer-events-none bottom-10 bg-muted justify-center h-12 mask-[linear-gradient(transparent,#000000)]"
>
</div>

<div class="social-icons px-4 pb-5 pt-1 flex self-center justify-center sticky bottom-0 bg-muted">
    <a href={`mailto:${SITE_EMAIL}`} class="mx-1 p-2.5 rounded-md" aria-label="Email" title="Email">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" style="fill: currentColor;" aria-hidden="true">
            <path d="M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8 6.223-8-6.222V6h16zM4 18V9.044l7.386 5.745a.994.994 0 0 0 1.228 0L20 9.044 20.002 18H4z"></path>
        </svg>
    </a>
    <a href={SITE_LINKEDIN} target="_blank" rel="noopener" class="mx-1 p-2.5 rounded-md" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" style="fill: currentColor;" aria-hidden="true">
            <circle cx="4.983" cy="5.009" r="2.188"></circle>
            <path d="M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z"></path>
        </svg>
    </a>
</div>
