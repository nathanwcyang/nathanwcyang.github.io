---
import { SITE_EMAIL, SITE_LINKEDIN } from "../config";
import { buttonVariants } from "@/components/ui/button";
---
<div class="mt-6 flex flex-wrap gap-3">
  <a class={buttonVariants()} href={`mailto:${SITE_EMAIL}`}>Email me</a>
  <a class={buttonVariants({ variant: "outline" })} href={SITE_LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
</div>
