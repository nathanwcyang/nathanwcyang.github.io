---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getSortedProjects } from "../lib/projects";

// Featured projects first, then newest. Add a file in src/content/projects/ and it shows up here.
const featured_projects = (await getSortedProjects()).slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <h1 class="type-display">I'm Nathan</h1>
    <p class="type-lede pt-3 pb-1">Doctor of Pharmacy Student, University of Waterloo · Class of 2027</p>
    <div class="py-2">
      <p class="text-lg">
        I have co-op experience in specialty, community and hospital pharmacy. I like finding the slow parts of a
        pharmacy workflow and building tools to fix them. Outside pharmacy, I make music, films and photographs.
      </p>
    </div>
    <div class="mt-8">
      <a class="btn" href="mailto:nwyang@uwaterloo.ca"> Let's connect!</a>
    </div>
  </div>

  <div>
    <h2 class="type-title w-full mb-2">Featured Projects</h2>
  </div>

  {
    featured_projects.map((project) => (
      <>
        <HorizontalCard
          title={project.data.title}
          img={project.data.heroImage}
          desc={project.data.description}
          url={"/projects/" + project.slug}
          target="_self"
          badge={project.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
