---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
---

<BaseLayout title="404: Not Found">
  <div class="text-center">
    <div class="text-9xl mb-4" aria-hidden="true">🏝</div>
    <h1 class="text-9xl font-bold mb-2">404</h1>
    <p class="text-2xl">The page you're looking for couldn't be found.</p>
    <a class={buttonVariants({ className: "mt-9" })} href="/">Back to home</a>
  </div>
</BaseLayout>
