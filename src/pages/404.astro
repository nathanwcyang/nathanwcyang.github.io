---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Button } from "../components/ui/Button";
---

<BaseLayout title="404: Not Found">
  <section class="py-24 text-center">
    <h1 class="text-8xl font-bold">404</h1>
    <p class="mt-2 text-xl text-secondary">The page you're looking for couldn't be found.</p>
    <div class="mt-8"><Button variant="primary" label="Back to home" href="/" /></div>
  </section>
</BaseLayout>
