---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="CV" sideBarActiveItemID="cv">
  <h1 class="sr-only">Nathan Yang: CV</h1>
  <div class="mb-5">
    <h2 class="type-title w-full">Profile</h2>
  </div>

  <div class="mb-10">
    Third-year Doctor of Pharmacy student at the University of Waterloo (Class of 2027), with co-op experience in specialty,
    community and hospital pharmacy. I look for friction in pharmacy workflows and build tools to remove it.
  </div>

  <div class="mb-5">
    <h2 class="type-title w-full">Education</h2>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement title="Doctor of Pharmacy Candidate (PharmD)" subtitle="2024 to 2027 at the University of Waterloo" />
    <TimeLineElement
      title="Bachelor of Health Sciences, Specialization in Health Sciences"
      subtitle="2018 to 2022 at Western University"
    />
  </div>

  <div class="mb-5">
    <h2 class="type-title w-full">Experience</h2>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement title="Pharmacy Student; Workflow Development" subtitle="Express Scripts Canada Pharmacy | Co-op | Mississauga, ON | May–August 2026">
      <ul class="list-disc ml-5 space-y-1">
        <li>Counselled patients by phone on specialty medications, including GLP-1/GIP agonists, CGRP antibodies, antiepileptics and injectable biologics</li>
        <li>Verified cold-chain prescriptions against manufacturer handling requirements</li>
      </ul>
      <p slot="achievements">Built <a href="/projects/rxcounsel" class="font-semibold text-primary underline">RxCounsel</a>, a self-initiated AI counselling-prep tool. Piloted with 3 pharmacists, it saved about 8 minutes per complex counselling session: roughly 1–1.5 hours a day per pharmacist.</p>
    </TimeLineElement>
    <TimeLineElement title="Pharmacy Student" subtitle="Rexall Pharmacy #1321 | Co-op | Mississauga, ON | September–December 2025">
      <ul class="list-disc ml-5 space-y-1">
        <li>Counselled patients on new and refill prescriptions and over-the-counter options</li>
        <li>Adjudicated insurance claims and set up InnoviCares copay assistance</li>
      </ul>
      <p slot="achievements">Led a two-month vaccine clinic, giving 500+ COVID-19 and flu vaccinations.</p>
    </TimeLineElement>
    <TimeLineElement title="Pharmacy Student" subtitle="Trillium Health Partners, Credit Valley Hospital | Co-op | Mississauga, ON | January–April 2025">
      <ul class="list-disc ml-5 space-y-1">
        <li>Stocked Pyxis cabinets with unit-dose and ward-stock medications, and tracked expiries and recalls</li>
        <li>Compounded and prepackaged narcotics, oral suspensions and PRN doses to NAPRA standards</li>
      </ul>
      <p slot="achievements">Led a data-analysis project for the lead medication management pharmacist, comparing the hospital's hazardous-medication list with the SaPHE list used by 5 Toronto hospitals, and presented the gap analysis.</p>
    </TimeLineElement>
    <TimeLineElement title="Collections Specialist" subtitle="CareRx Pharmacy | Full-time | Oakville, ON | May–September 2022">
      <ul class="list-disc ml-5 space-y-1">
        <li>Managed 120+ day overdue accounts after the Medical Pharmacies acquisition, working with long-term care and retirement homes across the GTA</li>
      </ul>
      <p slot="achievements">Collected over $150,000 in the first month.</p>
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <h2 class="type-title w-full">Certifications</h2>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>Injection certified (2025)</li>
    <li>Standard First Aid, CPR and AED Level C (2024 to 2027)</li>
  </ul>

  <div class="mb-5">
    <h2 class="type-title w-full">Skills</h2>
  </div>

  <ul class="list-disc mx-6 grid gap-2">
    <li><span class="font-semibold">Pharmacy software:</span> Propel, Kroll, Lexi-Drug, Microsoft Office</li>
    <li>
      <span class="font-semibold">Technical &amp; creative:</span> Claude and Copilot agents, React/Tailwind, DaVinci
      Resolve, audio mixing, photography
    </li>
  </ul>
</BaseLayout>
