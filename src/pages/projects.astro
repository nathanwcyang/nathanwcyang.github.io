---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getSortedProjects } from "../lib/projects";

const projects = await getSortedProjects();
const sections = [
  { category: "pharmacy", heading: "Pharmacy & Health Tech", empty: "More coming soon." },
  { category: "creative", heading: "Creative", empty: "Music, film and photography projects coming soon." },
];
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <h1 class="sr-only">Projects</h1>
  {
    sections.map((section, i) => {
      const items = projects.filter((p) => p.data.category === section.category);
      return (
        <>
          <h2 class={`type-title w-full mb-5 ${i > 0 ? "mt-10" : ""}`}>{section.heading}</h2>
          {items.length === 0 && <p class="opacity-75">{section.empty}</p>}
          <div class="flex flex-col gap-6">
          {items.map((project) => (
            <ProjectCard
            title={project.data.title}
            img={project.data.heroImage}
            desc={project.data.description}
            url={"/projects/" + project.slug}
            badge={project.data.badge}
          />
          ))}
          </div>
        </>
      );
    })
  }
</BaseLayout>
